{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Arona",
  "version": "3.4.0",
  "identifier": "com.studioarona.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd web && pnpm dev",
    "beforeBuildCommand": "cd web && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Studio Arona",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../services/sonetto/api": "services/sonetto/api",
      "../services/sonetto/requirements.txt": "services/sonetto/requirements.txt",
      "../services/sonetto/config": "services/sonetto/config",
      "../services/ocr/main.py": "services/ocr/main.py",
      "../services/ocr/requirements.txt": "services/ocr/requirements.txt"
    },
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "./Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
