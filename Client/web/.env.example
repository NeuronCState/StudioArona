# Hermes OpenAI-compatible endpoint.
#
# Copy this file to `.env` and adjust if your Hermes lives elsewhere:
#   cp .env.example .env
#
# Hermes (>= 0.16) ships a local OpenAI-compatible proxy under
#   `hermes proxy start`        (default: 127.0.0.1:8645, provider: nous)
# See `Client/web/src/components/agent/HERMES_INTEGRATION.md` for full
# setup notes; in short, you need Hermes proxy running and an upstream
# provider authenticated (Nous Portal or xAI Grok) for the agent panel
# to stream real responses.
#
# Override these to point at a different host / port / model. Anything
# left empty falls back to the in-code default.

VITE_HERMES_BASE_URL=http://127.0.0.1:8645
VITE_HERMES_MODEL=gpt-4o-mini
VITE_HERMES_API_KEY=local-hermes
