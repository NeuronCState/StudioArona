# ============================================================
# Studio Javis 生产环境变量（模板）
# 复制到服务器上: cp .env.production.template .env.production
# 修改其中的密钥后再启动
# ============================================================

# 通用
APP_ENV=production
LOG_LEVEL=info

# 数据库（容器内通过服务名访问）
DATABASE_URL=postgresql+asyncpg://javis:CHANGE_ME_PG_PASSWORD@postgres:5432/javis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
JWT_TTL_MIN=60
JWT_REFRESH_TTL_DAY=7

# LLM — MiniMax
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_MODEL=minimax-m2.7

# OpenClaw Gateway
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
OPENCLAW_STATE_DIR=/app/data/openclaw
OPENCLAW_CONFIG_PATH=services/agent/openclaw.json

# Agent Bridge
BRIDGE_PORT=18790
OPENCLAW_URL=http://127.0.0.1:18789

# Perception 平台（无摄像头/无GPU服务器）
PERCEPTION_PLATFORM=linux
PERCEPTION_CAMERA_DEVICE=mock
PERCEPTION_FACE_THRESHOLD=0.62
PERCEPTION_TRACK_FPS=15
PERCEPTION_SERIAL_PORT=mock
PERCEPTION_VM_BACKEND=mock

# Mock 开关（无硬件全开）
MOCK_NAS=true
MOCK_HA=true
MOCK_VM=true
MOCK_HARDWARE=true
MOCK_SERIAL=true
