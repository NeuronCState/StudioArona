# ============================================================
# Studio Javis 生产环境变量
# ============================================================

# 通用
APP_ENV=production
LOG_LEVEL=info

# 数据库
DATABASE_URL=postgresql+asyncpg://javis:javis@postgres:5432/javis
REDIS_URL=redis://redis:6379/0

# PostgreSQL 服务
PG_USER=javis
PG_PASSWORD=javis
PG_DB=javis

# Auth
JWT_SECRET=prod-javis-192168198145-secure-key-2026
JWT_TTL_MIN=60
JWT_REFRESH_TTL_DAY=7

# LLM — MiniMax
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_MODEL=minimax-m2.7

# OpenClaw
OPENCLAW_GATEWAY_TOKEN=c67b3d83ba476762a7d66a66620fb96efc879a5fb9a5926c

# Perception — 无摄像头/无GPU/无硬件
PERCEPTION_PLATFORM=linux
PERCEPTION_CAMERA_DEVICE=mock
PERCEPTION_FACE_THRESHOLD=0.62
PERCEPTION_TRACK_FPS=15
PERCEPTION_SERIAL_PORT=mock
PERCEPTION_VM_BACKEND=mock

# Mock 开关
MOCK_NAS=true
MOCK_HA=true
MOCK_VM=true
MOCK_HARDWARE=true
MOCK_SERIAL=true

# 服务名（用于 entrypoint）
WAIT_PG_HOST=postgres
WAIT_REDIS_HOST=redis
NAS_RSA_PRIVATE_
PERCEPTION_SPEECH_PROVIDER=mock
