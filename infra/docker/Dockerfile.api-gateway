# ============================================================
# api-gateway — FastAPI 网关，鉴权 / 限流 / SSE + WS 中转
# 使用: docker buildx build -f infra/docker/Dockerfile.api-gateway -t studio-javis/api-gateway:dev .
# ============================================================

# ---------- Stage 1: Builder ----------
FROM python:3.12-slim AS builder
WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    rm -f /var/cache/apt/archives/lock && \
    apt-get update && apt-get install -y --no-install-recommends build-essential

COPY pyproject.toml uv.lock ./
RUN mkdir -p services/api-gateway services/perception packages/contracts packages/skills
COPY services/api-gateway/pyproject.toml services/api-gateway/
COPY services/perception/pyproject.toml services/perception/
COPY packages/contracts/pyproject.toml packages/contracts/
COPY packages/skills/pyproject.toml packages/skills/
RUN --mount=type=cache,target=/root/.cache/uv \
    pip install uv -i https://pypi.tuna.tsinghua.edu.cn/simple &&     UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple uv sync --frozen --no-dev

# ---------- Stage 2: Runner ----------
FROM python:3.12-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends     postgresql-client netcat-openbsd curl libpq5 &&     rm -rf /var/lib/apt/lists/*

RUN groupadd -r javis && useradd -r -g javis -d /app javis

COPY --from=builder /app/.venv /app/.venv
COPY services/api-gateway/ /app/
COPY packages/contracts/ /app/packages/contracts/
COPY alembic.ini /app/alembic.ini
COPY infra/db/ /app/infra/db/
COPY infra/docker/scripts/entrypoint.sh /entrypoint.sh
COPY infra/docker/scripts/healthcheck.sh /healthcheck.sh

RUN chmod +x /entrypoint.sh /healthcheck.sh

USER javis
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD /healthcheck.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
