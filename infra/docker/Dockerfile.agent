FROM node:22-alpine AS builder
WORKDIR /build
COPY services/agent/package.json ./
RUN npm install --production

FROM node:22-alpine AS runner
RUN apk add --no-cache curl
RUN addgroup -S javis && adduser -S javis -G javis
COPY --from=builder /build/node_modules /app/node_modules
COPY services/agent/ /app/
COPY packages/skills/ /app/packages/skills/
COPY packages/contracts/ /app/packages/contracts/
RUN sed -i 's/127\.0\.0\.1/0.0.0.0/' /app/bridge/server.js
USER javis
WORKDIR /app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -sf http://localhost:8000/health || exit 1
CMD ["node", "bridge/server.js"]
