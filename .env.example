# ============================================================
# Studio Arona 环境变量
# 复制为 .env.local 后修改
# ============================================================

# 通用
APP_ENV=development
LOG_LEVEL=debug

# 数据库
DATABASE_URL=postgresql+asyncpg://javis:javis@localhost:5432/javis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-only-replace-me
JWT_TTL_MIN=60
JWT_REFRESH_TTL_DAY=7

# LLM — Hermes / LLM Gateway
# MiniMax (MiniMax) CN endpoint, used directly by services/llm_gateway/
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5-highspeed

# LLM Gateway (OpenAI 兼容代理)
# 端口 8645 (Hermes proxy 默认端口)
# LLM_GATEWAY_URL = LLM Gateway 自身服务 URL（Node bridge / api-gateway 反代用）
# MINIMAX_*  = 上游 MiniMax 兼容 API（services/llm_gateway 内部用）
LLM_GATEWAY_HOST=127.0.0.1
LLM_GATEWAY_PORT=8645
LLM_GATEWAY_URL=http://127.0.0.1:8645/v1/chat/completions
LLM_GATEWAY_SERVICE_URL=http://127.0.0.1:8645

# Agent Bridge (Node.js 业务桥)
BRIDGE_PORT=18790
AGENT_URL=http://localhost:18790

# Perception 平台 (auto = 从 platform.system() 自动检测; 也可手动指定 mac/linux/windows)
PERCEPTION_PLATFORM=auto
PERCEPTION_CAMERA_DEVICE=0
PERCEPTION_FACE_THRESHOLD=0.62
PERCEPTION_TRACK_FPS=15
PERCEPTION_SERIAL_PORT=mock
PERCEPTION_VM_BACKEND=mock

# Mock 开关（Mac 阶段全开）
MOCK_NAS=true
MOCK_HA=true
MOCK_VM=true
MOCK_HARDWARE=true
MOCK_SERIAL=true

# === Notifier (Email) ===
# Choose ONE backend:
#   (A) SMTP — for QQ / 163 / Gmail / outlook-365 work
#   (B) Microsoft Graph OAuth2 — for personal outlook.com (basic auth blocked)
# Set NOTIFY_SMTP_HOST to enable SMTP, or NOTIFY_OAUTH_CLIENT_ID to enable Graph.

# (A) SMTP
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_SSL=true
NOTIFY_FROM_NAME=什亭之匣 AI
NOTIFY_FROM_EMAIL=
NOTIFY_RETRY_MAX=3

# (B) Microsoft Graph OAuth2 (overrides SMTP if both set)
NOTIFY_OAUTH_TENANT_ID=common
NOTIFY_OAUTH_CLIENT_ID=
NOTIFY_OAUTH_CLIENT_SECRET=
NOTIFY_FROM_USER=
RSS_NOTIFY_DEBOUNCE_SEC=300  # 5min 防刷屏