# ============================================================
# Studio Javis 环境变量
# 复制为 .env.local 后修改
# ============================================================

# 通用
APP_ENV=development
LOG_LEVEL=debug

# 数据库
DATABASE_URL=postgresql+asyncpg://javis:javis@localhost:5432/javis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-only-replace-me
JWT_TTL_MIN=60
JWT_REFRESH_TTL_DAY=7

# LLM — OpenClaw 直接使用 MINIMAX_API_KEY
MINIMAX_API_KEY=
MINIMAX_MODEL=minimax-m2.7

# OpenClaw Gateway
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_STATE_DIR=~/.openclaw
OPENCLAW_CONFIG_PATH=services/agent/openclaw.json

# Agent Bridge
BRIDGE_PORT=18790
AGENT_URL=http://localhost:18790
OPENCLAW_URL=http://127.0.0.1:18789

# Perception 平台
PERCEPTION_PLATFORM=mac
PERCEPTION_CAMERA_DEVICE=0
PERCEPTION_FACE_THRESHOLD=0.62
PERCEPTION_TRACK_FPS=15
PERCEPTION_SERIAL_PORT=mock
PERCEPTION_VM_BACKEND=mock

# Mock 开关（Mac 阶段全开）
MOCK_NAS=true
MOCK_HA=true
MOCK_VM=true
MOCK_HARDWARE=true
MOCK_SERIAL=true
