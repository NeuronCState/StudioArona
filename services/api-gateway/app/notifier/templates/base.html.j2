<!doctype html>
<html><head><meta charset="utf-8">
<title>{% block subject %}{{ subject|default('什亭之匣 AI') }}{% endblock %}</title>
<style>
  body { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
         background: #f7f5f0; color: #2d2a26; margin: 0; padding: 0; }
  .wrap { max-width: 600px; margin: 0 auto; padding: 32px 24px; }
  .card { background: #fff; border-radius: 12px; padding: 32px;
          box-shadow: 0 2px 8px rgba(0,0,0,.04); }
  h1 { font-size: 20px; margin: 0 0 16px; color: #5a4a3a; }
  h2 { font-size: 16px; margin: 24px 0 8px; color: #5a4a3a; }
  .meta { color: #8b7d6e; font-size: 13px; margin-bottom: 16px; }
  .footer { text-align: center; color: #b0a596; font-size: 12px;
            margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee; }
  .pill { display: inline-block; padding: 2px 10px; border-radius: 999px;
          background: #efe8df; color: #6b5a47; font-size: 12px; }
  .btn { display: inline-block; padding: 10px 20px; border-radius: 8px;
         background: #c9a875; color: #fff; text-decoration: none; font-weight: 500; }
  a { color: #8a6d4b; }
  ul { padding-left: 18px; }
  li { margin-bottom: 8px; line-height: 1.5; }
  pre { background: #f4f0ea; padding: 12px; border-radius: 6px;
        overflow-x: auto; font-size: 12px; }
</style>
</head><body>
<div class="wrap">
  <div class="card">
    {% block body %}{% endblock %}
    <div class="footer">什亭之匣 AI · StudioArona · 来自 <a href="https://github.com/zhangxuanning/StudioArona">GitHub</a></div>
  </div>
</div>
</body></html>
