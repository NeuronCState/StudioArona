{% extends "base.html.j2" %}
{% block subject %}⏰ 日程提醒：{{ event.title }}{% endblock %}
{% block body %}
<h1>⏰ 日程提醒</h1>
<p class="meta">{{ user.display_name }}，这是你安排在 {{ starts_at }} 的日程：</p>

<h2>{{ event.title }}</h2>
{% if event.body %}
<p>{{ event.body }}</p>
{% endif %}

<p class="meta">
  <span class="pill">开始：{{ starts_at }}</span>
</p>

<p>— 什亭之匣 AI</p>
{% endblock %}
