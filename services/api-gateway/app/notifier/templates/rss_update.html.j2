{% extends "base.html.j2" %}
{% block subject %}📰 RSS 更新：{{ items|length }} 条{% endblock %}
{% block body %}
<h1>📰 RSS 订阅更新</h1>
<p class="meta">{{ user.display_name }}，你关注的源有新内容：</p>

<ul>
  {% for it in items %}
  <li>
    <a href="{{ it.link }}"><strong>{{ it.title }}</strong></a>
    {% if it.published %}<span class="meta">· {{ it.published }}</span>{% endif %}
    {% if it.summary %}<div>{{ it.summary[:200] }}{% if it.summary|length > 200 %}…{% endif %}</div>{% endif %}
  </li>
  {% endfor %}
</ul>
{% endblock %}
