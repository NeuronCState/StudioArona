{% extends "base.html.j2" %}
{% block subject %}🚨 容器告警：{{ service }}{% endblock %}
{% block body %}
<h1>🚨 容器告警</h1>
<div class="meta">{{ ts }} · 服务：<code>{{ service }}</code></div>

<h2>{{ message }}</h2>

{% if traceback %}
<h2>Traceback</h2>
<pre>{{ traceback }}</pre>
{% endif %}

<p>请尽快处理。</p>
{% endblock %}
