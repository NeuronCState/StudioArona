{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-javis/schemas/ws-events.json",
  "title": "WSEvents",
  "description": "/ws/events 事件总线消息定义。与 00_协作总纲与接口契约.md §3.3 同步。",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "type": { "const": "wake" },
        "user_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["type", "user_id"]
    },
    {
      "properties": {
        "type": { "const": "face_track" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "size": { "type": "number" }
      },
      "required": ["type", "x", "y"]
    },
    {
      "properties": {
        "type": { "const": "leave" },
        "duration_ms": { "type": "integer" }
      },
      "required": ["type"]
    },
    {
      "properties": {
        "type": { "const": "rotate_screen" },
        "orientation": { "enum": ["portrait", "landscape"] }
      },
      "required": ["type", "orientation"]
    },
    {
      "properties": {
        "type": { "const": "tracking" },
        "enabled": { "type": "boolean" }
      },
      "required": ["type", "enabled"]
    },
    {
      "properties": {
        "type": { "const": "metrics_update" },
        "payload": { "$ref": "./openapi.yaml#/components/schemas/SystemMetrics" }
      },
      "required": ["type", "payload"]
    },
    {
      "properties": {
        "type": { "const": "screen_changed" },
        "orientation": { "enum": ["portrait", "landscape"] }
      },
      "required": ["type", "orientation"]
    }
  ]
}
