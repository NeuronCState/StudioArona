{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-javis/schemas/ui-actions.json",
  "title": "UIActions",
  "description": "Agent 操控前端的事件类型定义。与 01_前端A_规划书.md §3 同步。",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "type": { "const": "navigate" },
        "to": { "type": "string", "description": "目标路由" }
      },
      "required": ["type", "to"]
    },
    {
      "properties": {
        "type": { "const": "highlight" },
        "selector": { "type": "string", "description": "CSS 选择器" }
      },
      "required": ["type", "selector"]
    },
    {
      "properties": {
        "type": { "const": "render_card" },
        "payload": { "type": "object", "description": "卡片数据" }
      },
      "required": ["type", "payload"]
    },
    {
      "properties": {
        "type": { "const": "clear_session" }
      },
      "required": ["type"]
    },
    {
      "properties": {
        "type": { "const": "toast" },
        "message": { "type": "string" },
        "level": { "enum": ["info", "warn", "error"] }
      },
      "required": ["type", "message"]
    },
    {
      "properties": {
        "type": { "const": "confirm" },
        "message": { "type": "string" },
        "action": { "type": "string", "description": "待确认的操作 ID" }
      },
      "required": ["type", "message", "action"]
    }
  ]
}
