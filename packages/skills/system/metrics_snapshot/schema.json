{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "system.metrics_snapshot",
  "version": "0.1.0",
  "input": { "type": "object", "properties": {} },
  "output": {
    "type": "object",
    "properties": {
      "metrics": {
        "type": "object",
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "cpu_cores": { "type": "array" },
          "mem_total_mb": { "type": "integer" },
          "mem_used_mb": { "type": "integer" },
          "disks": { "type": "array" },
          "gpus": { "type": "array" },
          "training_jobs": { "type": "array" }
        }
      }
    }
  }
}
