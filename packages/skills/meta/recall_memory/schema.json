{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recall_memory",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "query": { "type": "string" },
        "k": { "type": "integer", "default": 5 }
      },
      "required": ["user_id", "query"]
    },
    "outputs": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "summary": { "type": "string" },
              "importance": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
