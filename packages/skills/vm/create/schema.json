{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "vm.create",
  "version": "0.1.0",
  "input": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string", "description": "VM 名称" },
      "cpu": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
      "mem_gb": { "type": "integer", "minimum": 2, "maximum": 16, "default": 4 },
      "disk_gb": { "type": "integer", "minimum": 10, "maximum": 200, "default": 20 },
      "image": { "type": "string", "enum": ["ubuntu-22.04", "cuda-12.x"], "default": "ubuntu-22.04" },
      "owner_id": { "type": "string", "default": "default" }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "vm": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "cpu": { "type": "integer" },
          "mem_gb": { "type": "integer" },
          "disk_gb": { "type": "integer" },
          "image": { "type": "string" }
        }
      }
    }
  }
}
