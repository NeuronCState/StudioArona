{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "vm.list",
  "version": "0.1.0",
  "input": {
    "type": "object",
    "properties": {
      "owner_id": {
        "type": "string",
        "description": "所有者 ID（可选，不传则列出所有）"
      }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "vms": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "status": { "type": "string" },
            "cpu": { "type": "integer" },
            "mem_gb": { "type": "integer" },
            "disk_gb": { "type": "integer" }
          }
        }
      }
    }
  }
}
