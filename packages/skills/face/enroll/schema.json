{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "face.enroll",
  "version": "0.1.0",
  "input": {
    "type": "object",
    "required": ["user_id", "action"],
    "properties": {
      "user_id": {
        "type": "string",
        "description": "用户 ID"
      },
      "action": {
        "type": "string",
        "enum": ["start", "add_frame", "finalize", "cancel"],
        "description": "操作类型"
      }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "status": {
        "type": "string"
      },
      "frames_collected": {
        "type": "integer"
      }
    }
  }
}
