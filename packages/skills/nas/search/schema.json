{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "nas.search",
  "version": "0.1.0",
  "input": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": { "type": "string", "description": "搜索关键词" },
      "limit": { "type": "integer", "default": 10 }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "size_mb": { "type": "number" },
            "user": { "type": "string" },
            "relevance": { "type": "number" }
          }
        }
      }
    }
  }
}
