{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "nas.list_recent",
  "version": "0.1.0",
  "input": {
    "type": "object",
    "properties": {
      "limit": { "type": "integer", "default": 10, "minimum": 1, "maximum": 100 },
      "user_id": { "type": "string", "description": "按用户过滤（可选）" }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "size_mb": { "type": "number" },
            "user": { "type": "string" },
            "modified_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
