{
  "name": "studio-javis",
  "private": true,
  "scripts": {
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --config apps/web/eslint.config.js --fix",
      "prettier --write"
    ],
    "*.py": [
      "ruff check --select E,F,B",
      "ruff format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "openclaw",
      "esbuild",
      "sharp",
      "protobufjs",
      "koffi",
      "tree-sitter-bash",
      "@google/genai",
      "msw"
    ]
  }
}